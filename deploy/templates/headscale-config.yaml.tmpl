# ============================================================================
# Headscale 0.29.x configuration
# Generated by Skygate deploy system from .env.
#   Template: deploy/templates/headscale-config.yaml.tmpl
#   Rendered: deploy.sh → ${DEPLOY_HEADSCALE_DIR}/config/config.yaml
# ============================================================================

server_url: ${SKYGATE_CONTROL_URL}
listen_addr: 0.0.0.0:50444
metrics_listen_addr: 127.0.0.1:9090

tls:
  cert_path: ""
  key_path: ""

grpc_listen_addr: 0.0.0.0:50443
grpc_allow_insecure: true

# 2026-09-18: unix_socket is REQUIRED for the in-container CLI to work.
# Pre-fix this template only set grpc_listen_addr, so headscale did not
# create the unix socket while `headscale <cmd>` inside the container
# still dialled the default path — every `docker exec headscale headscale
# …` call failed with:
#   connecting to /var/run/headscale/headscale.sock: context deadline exceeded
# That silently broke approve-routes, tags, ACL file-mode fallback,
# preauth CLI fallback and user delete (routes.go:86, tags.go:48/92,
# acl.go:107/157, preauth.go:130/203, users.go:152/210, nodes.go:358).
# The CLI has no --socket flag (only -c/--config), so the socket MUST be
# declared here. See headscale v0.29.3 config-example.yaml:
#   unix_socket: /var/run/headscale/headscale.sock
#   unix_socket_permission: "0770"
unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

noise:
  private_key_path: /etc/headscale/noise_private.key

prefixes:
  v4: 100.64.100.0/10
  v6: fd7a:115c:a1e0::/48

dns:
  magic_dns: true
  base_domain: ${HEADSCALE_BASE_DOMAIN}
  nameservers:
    global:
      - 1.1.1.1
      - 8.8.8.8

derp:
  urls:
__HEADSCALE_DERP_URLS__
  auto_update_enabled: true
  update_frequency: 24h

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

log:
  level: ${HEADSCALE_LOG_LEVEL}
  format: text

registration_mode: no_registration

policy:
  mode: database
  auto_approve:
    routes:
__HEADSCALE_AUTO_APPROVE_ROUTES__
  tag_owners:
    "tag:public":
      - ${SKYGATE_ADMIN_USER}@${HEADSCALE_BASE_DOMAIN}
    "tag:exit-node":
      - ${SKYGATE_ADMIN_USER}@${HEADSCALE_BASE_DOMAIN}
    "tag:client":
      - ${SKYGATE_ADMIN_USER}@${HEADSCALE_BASE_DOMAIN}
