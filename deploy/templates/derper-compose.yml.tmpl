# ============================================================================
# DERP Relay — self-hosted Tailscale DERP server
# Generated by Skygate deploy system (deploy/deploy.sh render_template).
# Enabled only when DERP_ENABLED=true in .env.
#
# B260.2 (2026-09-17): switched `image:` from `ghcr.io/tailscale/derper:latest`
# to the locally-built `skygate-derper:latest`. The agent VM has outbound
# network restrictions that block ghcr.io (verified: `docker pull
# ghcr.io/tailscale/derper` returns "denied"). Operators who CAN reach
# ghcr.io can override via DERP_IMAGE=ghcr.io/tailscale/derper:latest in
# .env — the upstream image works identically for the manual-cert path
# (the `command:` below is the source of truth for runtime config; the
# image just needs to provide a `/derper` binary at the right path).
#
# B260.2 cert-mode contract:
#   DERP_CERTMODE=manual     — operator places cert files at
#                              ${DERP_CERT_DIR}/${DERP_HOSTNAME}.{crt,key}
#                              (mode 0600, owner root). The `command:`
#                              below passes `--certmode=manual
#                              --certdir=${DERP_CERT_DIR}` and binds
#                              `--a=:${DERP_DERP_PORT}` (443 in manual
#                              mode per derper --help: "Serves HTTPS if
#                              the port is 443 and/or -certmode is
#                              manual"). The HTTP challenge port is
#                              separate (`--http-port=${DERP_HTTP_PORT}`,
#                              default 80) — derper serves a redirect
#                              to HTTPS there.
#   DERP_CERTMODE=letsencrypt — derper fetches its own cert via ACME.
#                              Requires :80 reachable for HTTP-01 OR
#                              `--certdir` writable AND DNS access for
#                              DNS-01 (the official image supports
#                              `--certmode=manual` only; LE needs the
#                              built-in LE flow).
#
# B260.2 ports:
#   DERP_DERP_PORT (--a=)        — main HTTPS+DERP listen port, default
#                                   443. Manual cert mode REQUIRES :443
#                                   (or the upstream image's behavior
#                                   silently degrades to plain HTTP per
#                                   derper --help).
#   DERP_HTTP_PORT (--http-port=) — HTTP redirect port, default 80.
#   STUN :${DERP_STUN_PORT}/udp   — STUN endpoint, default 3478.
# ============================================================================
services:
  derper:
    image: ${DERP_IMAGE:-skygate-derper:latest}
    container_name: derper
    restart: unless-stopped
    # network_mode: host is mandatory for derper. The relay
    # advertises its hostname via DNS, so clients reach it on
    # the public IP. port-mapping (e.g. 443:443) would work
    # too but bind-mount network namespace is simpler and
    # matches the pre-B260.2 systemd unit's listen addresses.
    network_mode: host
    volumes:
      - ${DERP_CERT_DIR}:/var/lib/derper/certs:ro
      - ${DERP_CONFIG_DIR}/derper.conf:${DERP_CONFIG_DIR}/derper.conf:ro
    command: >
      -c=${DERP_CONFIG_DIR}/derper.conf
        --hostname=${DERP_HOSTNAME}
        --certmode=${DERP_CERTMODE}
        --certdir=${DERP_CERT_DIR}
        --a=:${DERP_DERP_PORT}
        --http-port=${DERP_HTTP_PORT}
        --stun
        --verify-clients=${DERP_VERIFY_CLIENTS_URL}

  derpmap:
    image: python:3-alpine
    container_name: derpmap
    restart: unless-stopped
    ports:
      - "${DERP_MAP_PORT}:8765"
    volumes:
      - ./derpmap.json:/derpmap.json:ro
    entrypoint: ["python3", "-c"]
    command:
      - |
        import http.server, json, os
        MAP = json.load(open('/derpmap.json'))
        BODY = json.dumps(MAP).encode()
        class H(http.server.BaseHTTPRequestHandler):
            def do_GET(self):
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.send_header('Content-Length', str(len(BODY)))
                self.end_headers()
                self.wfile.write(BODY)
            def log_message(self, *a): pass
        http.server.HTTPServer(('0.0.0.0', 8765), H).serve_forever()
