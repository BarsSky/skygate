# ============================================================================
# Headscale + Headplane docker-compose
# Generated by Skygate deploy system — do not edit manually.
# Edit .env and re-run deploy.sh to regenerate.
# ============================================================================
services:
  headscale:
    image: headscale/headscale:0.29.1
    container_name: headscale
    restart: unless-stopped
    command: serve
    ports:
      - "0.0.0.0:50444:50444"
    volumes:
      - headscale_data:/var/lib/headscale
      - ./config:/etc/headscale
    environment:
      - TZ=UTC
    networks:
      - headscale_default

  # 2026-07-14: Этап 14 v11 — Headplane is now a pinned, documented
  # optional module (see docs/headplane.md). The image tag is
  # sourced from ${HEADPLANE_IMAGE} in .env so a Skygate upgrade
  # never silently bumps a dependency. To skip the sidecar
  # entirely, set HEADPLANE_ENABLED=false (the deploy script
  # removes this block before generating the compose file).
  headplane:
    image: ${HEADPLANE_IMAGE}
    container_name: headplane
    restart: unless-stopped
    depends_on:
      - headscale
    ports:
      - "0.0.0.0:50445:50445"
    volumes:
      - ./headplane:/etc/headplane
      - headplane_data:/data
    environment:
      # Secrets injected from .env via Skygate deploy system.
      # DO NOT put real values here — edit the .env file at project root.
      - HEADPLANE_HEADSCALE__URL=${HEADPLANE_HEADSCALE__URL}
      - HEADPLANE_HEADSCALE__INSECURE=${HEADPLANE_HEADSCALE__INSECURE}
      - HEADPLANE_HEADSCALE__API_KEY=${HEADPLANE_HEADSCALE__API_KEY}
      - HEADPLANE_SERVER__HOST=${HEADPLANE_SERVER__HOST}
      - HEADPLANE_SERVER__PORT=${HEADPLANE_SERVER__PORT}
      - HEADPLANE_SERVER__COOKIE_SECURE=${HEADPLANE_SERVER__COOKIE_SECURE}
      - HEADPLANE_SERVER__COOKIE_SECRET=${HEADPLANE_SERVER__COOKIE_SECRET}
    # 2026-08-03: v0.32.16 — override the upstream image's healthcheck.
    #
    # The distroless headplane image (ghcr.io/tale/headplane:0.6.3) ships
    # /bin/hp_healthcheck that probes http://localhost:3000/admin/healthz.
    # But HEADPLANE_SERVER__PORT is 50445 by default, so the upstream
    # healthcheck always fails with "dial tcp [::1]:3000: connect:
    # connection refused" — Docker reports `(unhealthy)` with a 60+
    # failing streak even though the service is fine.
    #
    # Fix: probe http://127.0.0.1:${HEADPLANE_SERVER__PORT}/admin/healthz
    # using Node.js. The distroless image's only runtime binary is
    # /nodejs/bin/node (not in PATH for the healthcheck process), so
    # we must call it by absolute path. fetch() would also work on
    # Node 22+, but the lower-level require('http') avoids the
    # experimental-fetch warning that some deploy environments print.
    #
    # Why 127.0.0.1 (not localhost): IPv6 may resolve to [::1] and
    # headplane binds 0.0.0.0, not ::, so 127.0.0.1 is the only
    # loopback that consistently works in the distroless image.
    healthcheck:
      test: ["CMD", "/nodejs/bin/node", "-e", "require('http').get('http://127.0.0.1:${HEADPLANE_SERVER__PORT}/admin/healthz', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - headscale_default

volumes:
  headscale_data:
  headplane_data:

networks:
  headscale_default:
    name: headscale_default
    external: true
