# skygate PG HA env (v0.32.21).
#
# Copy to .env on BOTH skygate-host-1 and skygate-host-2, then fill in
# per-node values. The init scripts source this file.
#
# IMPORTANT: SKYGATE_PG_ADMIN_PASSWORD, SKYGATE_PG_REPLICATOR_PASSWORD,
# and SKYGATE_PG_SUPERUSER_PASSWORD must be the SAME on both VMs
# (they're cluster-wide, not per-node).

# === Per-node settings (DIFFERENT on each VM) ===

# On skygate-host-1:
#   SKYGATE_PG_NODE_NAME=skygate-host-1
#   SKYGATE_PG_NODE_IP=192.0.2.1
# On skygate-host-2:
#   SKYGATE_PG_NODE_NAME=skygate-host-2
#   SKYGATE_PG_NODE_IP=198.51.100.1
SKYGATE_PG_NODE_NAME=CHANGEME
SKYGATE_PG_NODE_IP=CHANGEME

# === Primary IP (same on both VMs) ===
SKYGATE_PRIMARY_IP=192.0.2.1

# === etcd endpoint ===
# Patroni talks to etcd on skygate-host-2. On skygate-host-2 itself
# this is 127.0.0.1; on skygate-host-1 this is skygate-host-2's IP.
SKYGATE_ETCD_HOST=198.51.100.1

# === PG passwords (same on both VMs) ===
# Generate with: openssl rand -base64 32
SKYGATE_PG_ADMIN_PASSWORD=CHANGEME_RANDOM_32_CHARS
SKYGATE_PG_REPLICATOR_PASSWORD=CHANGEME_RANDOM_32_CHARS
SKYGATE_PG_SUPERUSER_PASSWORD=CHANGEME_RANDOM_32_CHARS

# === MinIO (S3-compatible WAL archive) ===
# Same on both VMs.
MINIO_ROOT_USER=skygate-admin
MINIO_ROOT_PASSWORD=CHANGEME_RANDOM_32_CHARS
