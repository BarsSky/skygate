# ============================================================================
# Skygate Unified Environment
# ============================================================================
# cp .env.example .env  →  fill in real values  →  ./deploy/deploy.sh
#
# Generate secrets:
#   openssl rand -hex 32    # for SKYGATE_JWT_SECRET
#   openssl rand -hex 16    # for HEADPLANE_SERVER__COOKIE_SECRET
#   openssl rand -hex 32    # for DERP_PRIVATE_KEY
#
# Generate headscale API key (after headscale is running):
#   docker exec headscale headscale apikeys create --expiration 365d

# 2026-07-15: v0.12.0 — per-user headscale control plane keys
# (portal_users.headscale_api_key_enc) are encrypted with
# AES-256-GCM keyed by this 32-byte hex string. Required to
# enable multi-control-plane per portal user; leave empty
# if all users stay on the global default headscale.
# Generate: openssl rand -hex 32
SKYGATE_SECRET_KEY=

# ─── Exit-node health monitor (v0.13.0) ─────────────────────────
# Background goroutine polls headscale every
# SKYGATE_EXIT_NODE_CHECK_INTERVAL (default 5m) and updates
# the /admin/exit-nodes health banner. Disables with "off"
# or "0" (the deploy-time check
# `make check-nodes-strict` still runs from
# scripts/check_exit_nodes.py).
SKYGATE_EXIT_NODE_CHECK_INTERVAL=5m
# When true (default), run one immediate check at startup
# so a fresh skygate that's booting with all exit-nodes
# down sends the alert right away instead of waiting up
# to SKYGATE_EXIT_NODE_CHECK_INTERVAL.
SKYGATE_EXIT_NODE_CHECK_ON_STARTUP=true
# A node is "offline" if its last_seen is older than this
# window. Forgiving fallback for transient WireGuard
# session drops; headscale's `online` field flips to false
# the moment the WG socket closes, which can be a sleeping
# laptop as much as a dead relay.
SKYGATE_EXIT_NODE_OFFLINE_AFTER=2m
# When true, the monitor's per-tick path also upserts
# headscale→portal mappings (db.SyncNodesFromHeadscale).
# Off by default. Opt in on single-tailnet deployments
# where the cost of one SELECT + one INSERT/UPDATE per
# node per tick is fine and the value (no orphan
# exit-nodes in /admin/exit-nodes or /exit_nodes) is
# worth it. Large multi-thousand-node tailnets should
# leave this off and use the explicit
# /admin/devices "Sync from headscale" button.
SKYGATE_EXIT_NODE_AUTO_SYNC=false

# ─── Skygate ───────────────────────────────────────────────────────────────
SKYGATE_PORT=8080
SKYGATE_DB=/data/skygate.db
SKYGATE_JWT_SECRET=<openssl rand -hex 32>
SKYGATE_ADMIN_USER=admin
SKYGATE_ADMIN_PASS=<choose strong password 16+ chars>
SKYGATE_CONTROL_URL=https://head.example.com

# 2026-08-03: v0.32.29 — operator-specific DNS / IPs /
# usernames moved out of source code and into env. The
# defaults below are RFC 5737 documentation IPs and the
# example.com domain; live deployments MUST override
# these to their real values.
SKYGATE_BASE_DOMAIN=tsnet.example.com
# The headscale user that owns tag:public + tag:exit-node
# in the generated ACL. Should match SKYGATE_ADMIN_USER
# (the user that gets bootstrapped on first run). Default
# "admin" (placeholder).
SKYGATE_ADMIN_IDENTITY=admin
# DERP relay base URL (the /admin/derp page polls this
# for the snapshot). Default placeholder.
SKYGATE_DERP_BASE_URL=http://derp.example.com:8766
# IP of the operator's Nginx Proxy Manager (persistent
# WebSocket pool to the derper). Default 192.0.2.67
# (RFC 5737 documentation IP — does not match real
# traffic; set this to your NPM's actual LAN IP).
SKYGATE_DERP_PEER_NPM=192.0.2.67
# Operator's LAN CIDR (used to classify DERP peer
# connections as "lan" vs "ws_admin" vs "ws_relay").
# Default 192.0.2.0/24 (RFC 5737). Set to your real
# LAN CIDR (e.g. 192.168.1.0/24).
SKYGATE_DERP_LAN_NET=192.0.2.0/24

# ─── Headscale ─────────────────────────────────────────────────────────────
HEADSCALE_URL=http://headscale:50444
HEADSCALE_API_KEY=<docker exec headscale headscale apikeys create --expiration 365d>
HEADSCALE_CONTAINER=headscale
HEADSCALE_SERVER_URL=https://head.example.com
HEADSCALE_BASE_DOMAIN=tsnet.example.com
# Comma-separated CIDRs; converted to YAML list at deploy time
HEADSCALE_AUTO_APPROVE_ROUTES=0.0.0.0/0,::/0
# Comma-separated DERP map URLs
HEADSCALE_DERP_URLS=https://controlplane.tailscale.com/derpmap/default
HEADSCALE_LOG_LEVEL=info

# ─── Headplane (optional sidecar UI) ───────────────────────────────────────
# 2026-07-14: Этап 14 v11 — Headplane is now a documented optional
# module. See docs/headplane.md for the integration contract,
# compatibility matrix, and version pin policy.
#
# To skip the Headplane sidecar entirely, set HEADPLANE_ENABLED=false
# (skips pulling the image + starting the container in
# deploy.sh). The default is true.
HEADPLANE_ENABLED=true
# Pinned to a specific release; the v0.6.3 image supports
# Headscale 0.28+ and is the latest stable as of 2026-04-09.
# See https://headplane.net/CHANGELOG for upstream releases.
HEADPLANE_IMAGE=ghcr.io/tale/headplane:0.6.3
# 2026-07-15: v0.10.12 — point Skygate at an EXISTING Headplane
# instead of starting a second sidecar. When set, deploy.sh
# skips the headplane container in docker-compose.yml and the
# /admin/acls view links to this URL instead of the local
# sidecar. Leave empty to use the bundled sidecar.
# See docs/headplane.md "Use an existing Headplane" for details.
HEADPLANE_EXTERNAL_URL=
# Env overrides use HEADPLANE_ prefix + __ for nesting.
# These override values in deploy/templates/headplane-config.yaml
HEADPLANE_HEADSCALE__URL=http://headscale:50444
HEADPLANE_HEADSCALE__INSECURE=true
HEADPLANE_HEADSCALE__API_KEY=<same as HEADSCALE_API_KEY above>
HEADPLANE_SERVER__HOST=0.0.0.0
HEADPLANE_SERVER__PORT=50445
HEADPLANE_SERVER__COOKIE_SECURE=false
HEADPLANE_SERVER__COOKIE_SECRET=<openssl rand -hex 16>

# ─── Exit Node SSH Sync ────────────────────────────────────────────────────
# Path inside skygate container to SSH private key
SKYGATE_EXIT_SSH_KEY=/home/admin/.ssh/skygate_sync
# SSH targets for syncing advertised routes (hostname or IP)
SKYGATE_EXIT_SSH=root@relay-a
SKYGATE_EXIT_SSH_RELAY_B=root@relay-b
SKYGATE_EXIT_SSH_RELAY_C=root@relay-c

# ─── DERP Relay ────────────────────────────────────────────────────────────
DERP_ENABLED=false
DERP_HOSTNAME=derp.example.com
DERP_PRIVATE_KEY=<openssl rand -hex 32>
DERP_VERIFY_CLIENTS_URL=https://head.example.com
DERP_STUN_PORT=3478
DERP_HTTP_PORT=8443
DERP_MAP_PORT=8765
# 2026-07-15: v0.10.12 — comma-separated URLs of EXISTING DERP
# relays to add to headscale's derp.urls list (alongside the
# public Tailscale DERP). When set, deploy.sh skips the bundled
# derper container — only the external ones are wired in.
# Compatible with Tailscale's own headscale derp.urls format.
# See docs/derp.md "Use an existing DERP relay" for the contract.
DERP_EXTERNAL_URLS=

# ─── Deployment paths ──────────────────────────────────────────────────────
DEPLOY_HEADSCALE_DIR=/home/admin/headscale
DEPLOY_SKYGATE_DIR=/home/admin/skygate
DEPLOY_BACKUP_DIR=/home/admin/skygate/backup
DOCKER_NETWORK=headscale_default
DOCKER_SUBNET=172.18.0.0/16

# ─── HTTPS reverse proxy (Caddy, v0.15.0) ──────────────────────────────
# 2026-07-15: v0.15.0 — optional Caddy sidecar handles TLS
# termination for all public-facing modules. The sidecar
# is gated behind Docker profiles + CADDY_ENABLED so
# that operators who run an EXTERNAL TLS terminator
# (Nginx Proxy Manager on a separate host, Cloudflare
# Tunnel, Caddy on a separate VM, Tailscale TLS, …)
# aren't forced to either disable caddy after every
# deploy or chase a broken-cert error when the
# placeholder Caddyfile can't issue for the real
# hostname.
#
# 2026-07-31: v0.32.11 — DEFAULT FLIPPED to `false`.
# Reason: in practice > 90% of operators already have
# an external TLS layer (NPM is the most common, with
# Cloudflare Tunnel a close second). The old `true`
# default made caddy race for ports 80/443 on every
# host where the operator didn't want it, and the
# placeholder Caddyfile then silently broke the public
# site when no real DNS-01 token was set. See
# docs/https-setup.md § "Caddy is off by default" for
# the full rationale + the opt-in procedure.
#
#  ▸ CADDY_ENABLED=false (default):
#      • caddy container is NOT started
#      • ports 80/443 stay free for whatever external
#        terminator the operator already runs
#      • deploy.sh skips Caddyfile rendering entirely
#      • nothing in docker-compose.yml needs to change
#
#  ▸ CADDY_ENABLED=true:
#      • caddy container is started (Docker profile
#        `caddy` is added at `up -d` time)
#      • you MUST set CADDY_HOSTS_HEAD to a real
#        hostname whose DNS A/AAAA points at this host
#        (placeholder `head.example.com` will fail ACME
#        with "forbidden by policy")
#      • you MUST set either:
#          - CADDY_DNS_PROVIDER=cloudflare +
#            CADDY_DNS_API_TOKEN_FILE with a real token
#            (DNS-01, no port 80 needed), or
#          - CADDY_DNS_PROVIDER=http
#            (HTTP-01, port 80 must be reachable from
#            the public Internet, no token needed)
#
# To opt in after a default-disabled deploy: set
# CADDY_ENABLED=true in .env, then re-run deploy.sh.
# The caddy container is created from the profile and
# starts automatically; certs issue on first request.
CADDY_ENABLED=false
# DNS provider for Let's Encrypt DNS-01. Caddy
# supports 30+ via the caddy-dns plugin; common
# choices: cloudflare, route53, gandi, digitalocean,
# googlecloud, hetzner, ovh, namecheap, porkbun,
# desec. Set to "http" for the simpler HTTP-01
# challenge (requires port 80 reachable from the
# public Internet).
CADDY_DNS_PROVIDER=cloudflare
# API token with Zone:DNS:Edit on the apex domain.
# The token is read from a separate file (NOT .env)
# so the rendered Caddyfile is safe to commit to git.
# Generate:  mkdir -p /var/lib/skygate/secrets
#             echo "<token>" > /var/lib/skygate/secrets/caddy-dns-token
#             chmod 600 /var/lib/skygate/secrets/caddy-dns-token
CADDY_DNS_API_TOKEN_FILE=/var/lib/skygate/secrets/caddy-dns-token
# Public hostnames the Caddy sidecar will issue certs
# for. Each entry is a separate virtual host; the
# routing is in the rendered Caddyfile.
CADDY_HOSTS_HEAD=head.example.com
CADDY_HOSTS_HEADPLANE=headplane.example.com
CADDY_HOSTS_DERP=derp.example.com
# Optional: enable HSTS (HTTP Strict Transport Security).
# Default true; the operator's browser will refuse
# plain-HTTP connections to these hostnames for 6
# months after the first visit. Disable only for
# testing.
CADDY_HSTS=true
