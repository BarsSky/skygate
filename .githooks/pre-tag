#!/usr/bin/env bash
# .githooks/pre-tag — refuses to create a tag unless CI is green for that
# exact commit.
#
# Why (2026-09-22): the v1.5.41 → v1.5.45 release cycle bypassed the
# pre-push gate with `git push --no-verify`. CI caught two real regressions
# in that window (v1.5.44 introduced an RU i18n parity break AND a
# raw-http.Error leak) — but the tags already existed, so the release
# workflow built and published binaries from a commit CI never accepted.
#
# B280 (v1.5.46): this hook is now a thin caller of scripts/ci_gate.sh, the
# single implementation of "is CI green for this sha?". The same script runs
# as the `preflight` job in .github/workflows/release.yml (server side) and
# in .github/workflows/tag-release.yml (the sanctioned way to create a tag).
# Three callers, one answer — a hook is per-clone and `--no-verify` skips
# it, so the server-side half is what actually guarantees the rule.
#
# Behaviour:
#   - Non-version tags (branches, scratch tags): bypass.
#   - Version tag (vX.Y.Z / vX.Y.Z-rcN) + CI not green, still running, no run
#     at all, or the commit is not on main: refuse (exit 1).
#   - Same, but the check cannot be performed (no gh, not authenticated,
#     API error): refuse (exit 2 from the gate → exit 1 here). An
#     unverifiable commit is not a tested one.
#   - Version tag + CI green on main: proceed.
#
# Escape hatch: SKIP_PRE_TAG_CHECK=1 git tag -a vX.Y.Z ...
# (Only in a true emergency, with the justification written into the release
# notes. It bypasses THIS hook only — release.yml still refuses to publish.)
#
# Enable:
#   git config core.hooksPath .githooks

set -u

refname="$1"
sha1="$2"

# Bypass for non-version tags (branches, scratch, etc.).
if ! [[ "$refname" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] && ! [[ "$refname" =~ ^v[0-9]+\.[0-9]+\.[0-9]+-rc[0-9]+$ ]]; then
    exit 0
fi

# Escape hatch.
if [ "${SKIP_PRE_TAG_CHECK:-0}" = "1" ]; then
    echo "pre-tag: SKIP_PRE_TAG_CHECK=1 — bypassing the CI gate for $refname ($sha1)" >&2
    echo "        release.yml will STILL refuse to publish if CI is not green." >&2
    exit 0
fi

# Find the shared gate. A missing script is a refusal, not a pass: the gate
# is the contract (AGENTS.md §1.1), and silently tagging when it is absent
# is exactly the failure this hook exists for.
root="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
gate="$root/scripts/ci_gate.sh"
if [ ! -f "$gate" ]; then
    echo "pre-tag: refusing to tag $refname — $gate not found" >&2
    echo "        (the CI gate is scripts/ci_gate.sh; without it 'CI is green' cannot be checked)" >&2
    exit 1
fi

# Refresh origin/main so the ancestry check is not fooled by a stale
# remote-tracking ref (tagging right after a push is the common case).
git fetch --no-tags --quiet origin main:refs/remotes/origin/main 2>/dev/null || true

set +e
bash "$gate" --sha "$sha1" --branch main
rc=$?
set -e 2>/dev/null || true

if [ "$rc" -eq 0 ]; then
    exit 0
fi

echo "" >&2
if [ "$rc" -eq 2 ]; then
    echo "        The CI status could not be verified, so the tag is refused." >&2
    echo "        Fix the environment (gh installed + authenticated) and retry." >&2
else
    echo "        Fix the failing/absent CI runs for $sha1, or wait for a run" >&2
    echo "        in progress to finish, then retry." >&2
fi
echo "        Emergency bypass: SKIP_PRE_TAG_CHECK=1 git tag -a $refname ..." >&2
echo "        (release.yml still refuses to publish an ungated tag.)" >&2
exit 1
